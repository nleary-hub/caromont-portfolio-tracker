# ---------------------------------------------------------------------------
# Service Line Portfolio Tracker: environment variables
# Copy to .env.local for local dev. On Vercel, set these in Project Settings.
# ---------------------------------------------------------------------------

# PostgreSQL (Vercel Postgres / Neon / local). Use the POOLED URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > Credentials > OAuth client ID, type Web application).
# Redirect URIs to register (see README "Google OAuth setup"):
#   https://caromont-portfolio-tracker-nleary-2832.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Who may sign in. Comma/space/semicolon separated. Exact emails, or "@domain" for a whole domain.
# Trimmed and case-insensitive. People on ADMIN_EMAILS may also sign in.
# Both lists empty = nobody can sign in (fails closed).
ALLOWED_EMAILS="you@example.org"

# Admins (same format). May sign in even if not on ALLOWED_EMAILS. Empty = no admins.
ADMIN_EMAILS="admin@example.org"

# trustHost: not needed on Vercel (Auth.js trusts the host when the VERCEL env var is present).
# Do NOT set AUTH_URL on Vercel. Only for self-hosted `next start` behind a proxy:
# AUTH_TRUST_HOST="true"
# AUTH_URL="http://localhost:3000"
