# ---------------------------------------------------------------------------
# Service Line Portfolio Tracker: environment variables
# Copy to .env.local for local dev. On Vercel, set these in Project Settings.
# ---------------------------------------------------------------------------

# PostgreSQL (Vercel Postgres / Neon / local). Use the POOLED URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Optional: DIRECT (non-pooled) URL for Prisma CLI migrations (Neon: host without "-pooler").
# Falls back to DATABASE_URL when unset. The Vercel Neon integration sets this automatically.
DATABASE_URL_UNPOOLED=""

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Comma/space/semicolon separated. Exact emails, or "@domain" to allow a whole domain.
# Empty = nobody can sign in (fails closed).
ALLOWED_EMAILS="you@example.org"

# Admins (same format as ALLOWED_EMAILS; must also be allowlisted). Only admins can change view
# settings, hide or delete projects, open /admin/audit and use /admin/import (CSV import/export).
# Empty = no admins (fails closed).
ADMIN_EMAILS="admin@example.org"

# --- Sign-in providers (each is enabled only if its vars are set) -----------
# Microsoft Entra ID (recommended for CaroMont). Redirect URI:
#   https://<your-domain>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0/"

# Google (optional). Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: email-only sign-in form (still subject to ALLOWED_EMAILS).
# Ignored whenever NODE_ENV=production (i.e. `next start` and all Vercel deployments).
AUTH_DEV_LOGIN="false"

# Needed when not on Vercel (e.g. local `next start` behind a proxy).
# AUTH_TRUST_HOST="true"
# AUTH_URL="http://localhost:3000"

# --- Biweekly report freeze and delivery (see docs/REPORTS.md) ---------------
# Bearer secret for /api/cron/freeze. Vercel sends it on its cron calls. Empty = endpoint refuses all calls.
CRON_SECRET=""
# HMAC key for the 7-day signed fallback links (32+ chars). Empty = no fallback link.
SHARE_LINK_SECRET=""
# Absolute app URL for links in handoff.json and signed links (defaults to the Vercel production URL).
APP_BASE_URL="https://your-app.example.org"
# Single address written into handoff.json as reportRecipient. The app never sends email.
REPORT_RECIPIENT_EMAIL="you@example.org"
# Google Drive delivery (OAuth refresh token for your own account, scope drive.file). Empty = signed link.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Optional. Leave empty so the app creates its own folder (drive.file cannot write to hand-made folders).
GOOGLE_DRIVE_FOLDER_ID=""
