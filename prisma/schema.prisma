// Service Line Portfolio Tracker: Prisma schema
// Connection string is supplied via DATABASE_URL (see prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Report order is the declaration order below.
enum ServiceArea {
  Cath
  EP
  Echo
  CVSS
  INU
  CardioNeuro
  IR
}

enum ProjectStatus {
  NotStarted
  OnTrack
  AtRisk
  OffTrack
  OnHold
  Complete
  Cancelled
}

/// Where a set of view settings applies.
enum ViewContext {
  dashboard
  report
}

enum RecipientLine {
  To
  Cc
}

model Project {
  id                     String        @id @default(uuid()) @db.Uuid
  /// Service line the project belongs to (migration 0016). Every read and write is scoped through
  /// ServiceLineAccess, which always passes the line. The DB default (CVPSL) only covers writes from the previous
  /// deployment while migration 0016 is deployed.
  serviceLineId          String        @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  name                   String
  /// What the project is. Optional. Length limit is AppConfig.DESCRIPTION_MAX_LENGTH (200), enforced in app validation.
  description            String?
  /// Infor request number: optional whole number 1 to 99999 (shown as "REQ-5081"). Range enforced in app
  /// validation (AppConfig.INFOR_REQUEST_NUMBER_MIN/MAX); DB check constraint as backstop.
  inforRequestNumber     Int?          @map("infor_request_number")
  /// LEGACY (kept in step with departmentId by the Project_department_sync trigger, migration 0018, so the previous
  /// deployment keeps working during the deploy window). The app reads and writes departmentId only.
  serviceArea            ServiceArea?
  /// The project's department (null = Unassigned, grouped last). Migration 0018.
  departmentId           String?       @db.Uuid
  owner                  String?
  physicianChampion      String?
  physicianChampionEmail String?
  /// Requester (physicianChampion) marked Not applicable: renders blank. A name clears it.
  requesterNotApplicable Boolean       @default(false)
  /// Contracts lead, one of the project's service line contractsLeads (null = "To assign").
  contractsLead          String?
  status                 ProjectStatus
  /// Required unless status is Complete/Cancelled (enforced in app validation).
  nextMilestone          String?
  dueDate                DateTime?     @db.Date
  targetCompletion       DateTime?     @db.Date
  /// 0 to 100 (enforced in app validation; DB check constraint as backstop).
  percentComplete        Int?
  /// Length limit is AppConfig.NOTE_MAX_LENGTH (2,000), enforced on save in app validation. The dashboard and PDF
  /// show at most AppConfig.NOTE_DISPLAY_MAX_LENGTH (200) characters.
  note                   String?
  /// What the finished project accomplished (optional; shown in the report's "Completed this period" block).
  /// Length limit is AppConfig.ACCOMPLISHMENT_MAX_LENGTH (200), enforced in app validation.
  accomplishment         String?
  /// Completion date as entered (optional; display only). The "Completed this period" clock is the time the
  /// status became Complete in the app (ProjectHistory), never this date.
  completedOn            DateTime?     @db.Date
  /// Automatic completion date (migration 0030): the America/New_York day the last open milestone was checked off.
  /// Shown only while the status is Complete and no completedOn (hand-entered, always wins) is set. CompletionRules.
  completedAtAuto         DateTime?     @db.Date
  /// The automatic date kept while a new or unchecked milestone has reopened the project (migration 0030), so
  /// deleting that new milestone restores it. Cleared when the project completes again or the status is set by hand.
  previousAutoCompletedAt DateTime?     @db.Date
  /// Set when the project was listed in a frozen report's "Completed this period" block, so it is listed
  /// only once. Cleared when the status leaves Complete. Bookkeeping only (no history row).
  completionReportedAt   DateTime?
  includeInReport        Boolean       @default(true)
  /// When work on the project began: an America/New_York calendar day (migration 0026). The New project form
  /// pre-fills today (ET); CSV-created projects get the import day. Existing projects got their createdAt as an ET
  /// day. Changing it is not a status update (ProjectService.applyStartDate): no Changed, no Stale reset, no
  /// "Updated" date, no public history row; the change is audited in an admin-only "startDate" history row.
  /// The DB default (today, ET) only covers inserts from the previous deployment while 0026 is deployed.
  startDate              DateTime      @default(dbgenerated("((now() AT TIME ZONE 'America/New_York'::text))::date")) @db.Date
  /// True while startDate is the import default (the import day, not a date someone entered). Shown as a "Default"
  /// tag in the drawer so an admin can correct it; cleared when someone saves another start date.
  startDateIsDefault     Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  updatedBy              String
  /// Soft delete only (admin "Delete"); projects are never hard deleted. Deleted projects are invisible to non-admins.
  archivedAt             DateTime?
  /// Who soft-deleted the project (admin email). Set together with archivedAt; cleared on restore.
  deletedBy              String?
  /// Admin per-project hide, per context. Hidden projects are invisible to non-admins in that context
  /// (rows, counts, flags, history). Only ProjectService admin methods write these; every change is audited.
  hiddenFromDashboard    Boolean       @default(false)
  hiddenFromReport       Boolean       @default(false)
  /// DEPRECATED (unused since view settings replaced the "closed projects drop off after one report"
  /// rule). Kept so existing data is not destroyed; nothing reads or writes it.
  closedReportedAt       DateTime?

  history           ProjectHistory[]
  priorInforNumbers ProjectPriorInforNumber[]
  milestones        ProjectMilestone[]
  serviceLine       ServiceLine               @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  department        Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([serviceArea, status])
  @@index([departmentId])
  @@index([archivedAt])
  @@index([serviceLineId, archivedAt])
}

/// Append-only audit trail. No update/delete paths exist in the app; DB triggers block them too.
model ProjectHistory {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  changedBy String
  comment   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt])
  @@index([changedAt])
}

/// Immutable report snapshot. Only delivery fields (pdfStorageKey, sentAt, sentToJson) may be filled in later.
model ReportSnapshot {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Service line the report is for (migration 0016). Scheduled freezes are the default line (CVPSL) only.
  /// Immutable (snapshot guard).
  serviceLineId        String    @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  periodStart          DateTime  @db.Date
  periodEnd            DateTime  @db.Date
  generatedAt          DateTime  @default(now())
  generatedBy          String
  /// Frozen copy of the rows visible in the report view at freeze (ReportRow[]).
  rowsJson             Json
  /// Storage reference (URL or blob key) for the rendered PDF. Null until rendered.
  pdfStorageKey        String?
  sentAt               DateTime?
  sentToJson           Json?
  /// MissingChampion[] computed at generation time.
  missingChampionsJson Json
  /// ReportHeader: status counts overall and per area, computed from the visible (listed) rows only.
  /// Null only for snapshots created before migration 0002.
  headerJson           Json?
  /// ADMIN-ONLY. ViewSettingsValue (report context) in effect at freeze, kept for reproducibility.
  /// Never render to non-admins (VisibilityPolicy.snapshotForViewer strips it). Null only before migration 0002.
  viewSettingsJson     Json?
  /// ADMIN-ONLY. Latest delivery outcome (DeliveryRecord: Drive file ids or the signed fallback link).
  /// The only snapshot field that may change more than once (delivery retries); every attempt is
  /// also logged append-only in report_deliveries.
  deliveryJson         Json?
  /// ReportOptionsValue (e.g. key page on/off) in effect at freeze. Immutable. Null before migration 0004.
  optionsJson          Json?
  /// CompletedRow[]: the "Completed this period" blocks at freeze (visible Complete projects not yet reported).
  /// Immutable. Null before migration 0012.
  completedJson        Json?
  /// ServiceLineValue (service line name and short name) in effect at freeze, used for the report title.
  /// Immutable. Null before migration 0014 (those reports render with the legacy title).
  serviceLineJson      Json?
  /// LineLayoutValue (column order and width shares, row order per department) of the line at freeze. Immutable.
  /// Null before migration 0017 (those reports render with the default columns and order).
  layoutJson           Json?
  /// DepartmentInfo[]: the line's departments at freeze (id, name, short name, in report order), so a frozen report
  /// keeps the names it was frozen with. Immutable. Null before migration 0018 (those use the legacy labels).
  departmentsJson      Json?

  artifacts   ReportArtifact[]
  deliveries  ReportDelivery[]
  serviceLine ServiceLine      @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  /// One snapshot per report period: the freeze job is idempotent on this key.
  @@unique([periodStart, periodEnd])
  @@index([generatedAt])
}

/// Immutable rendered files of a snapshot (PDF, handoff.json). ReportSnapshot.pdfStorageKey points here
/// as "db:report_artifacts/<id>". DB triggers block UPDATE/DELETE.
model ReportArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @db.Uuid
  /// "pdf" | "handoff"
  kind        String
  fileName    String
  contentType String
  bytes       Bytes
  byteSize    Int
  sha256      String
  createdAt   DateTime @default(now())

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, kind])
  @@map("report_artifacts")
}

/// Append-only log of delivery attempts (Drive upload or signed-link fallback). DB trigger blocks UPDATE/DELETE.
model ReportDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @db.Uuid
  attemptedAt DateTime @default(now())
  /// "drive" | "signed_link"
  method      String
  /// "ok" | "failed" | "skipped"
  status      String
  /// Method details: Drive file ids and links, or the signed link and its expiry, or the error.
  detailJson  Json
  triggeredBy String

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([snapshotId, attemptedAt])
  @@map("report_deliveries")
}

/// Kept in the schema, but nothing drives sending from it: the report email goes to Nick's work email only.
model Recipient {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  email       String        @unique
  role        String?
  /// Null = all service areas.
  serviceArea ServiceArea?
  line        RecipientLine
  /// Deactivate, never delete.
  active      Boolean       @default(true)
}

/// Global (not per-user) show/hide settings, one row per context. Only written by ViewSettingsService.
model ViewSettings {
  context        ViewContext     @id
  /// Full column order for the context (ViewColumn keys, see ViewSettings). Validated in the app.
  columnOrder    String[]
  /// Hidden ViewColumn keys. Locked columns (project, status) are never stored here.
  hiddenColumns  String[]
  hiddenStatuses ProjectStatus[]
  updatedAt      DateTime        @updatedAt
  updatedBy      String

  @@map("view_settings")
}

/// Append-only audit trail of view settings changes. DB trigger blocks UPDATE/DELETE.
model ViewSettingsHistory {
  id        String      @id @default(uuid()) @db.Uuid
  context   ViewContext
  /// ViewSettingsValue before the change.
  oldValue  Json
  /// ViewSettingsValue after the change.
  newValue  Json
  changedAt DateTime    @default(now())
  changedBy String

  @@index([context, changedAt])
  @@map("view_settings_history")
}

/// Admin report options, one row per service line (the default line keeps id "report"). Only
/// ReportOptionsService writes it; every change is appended to report_options_history in the same transaction.
model ReportOptions {
  id            String      @id @default("report")
  serviceLineId String      @unique @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  /// Last page with the status and flag key. Default on.
  showKeyPage   Boolean     @default(true)
  /// Weekly PDF department bar color (migration 0027): navy (default), deeper-plum, plum or a custom "#RRGGBB".
  barColor      String      @default("navy")
  /// Band behind the page 1 title: none (default), a preset key or a custom "#RRGGBB".
  headerBand    String      @default("none")
  updatedAt     DateTime    @updatedAt
  updatedBy     String

  @@map("report_options")
}

/// Append-only audit trail of report options changes. DB trigger blocks UPDATE/DELETE.
model ReportOptionsHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  oldValue      Json
  newValue      Json
  changedAt     DateTime    @default(now())
  changedBy     String

  @@index([changedAt])
  @@index([serviceLineId, changedAt])
  @@map("report_options_history")
}

/// LEGACY (read by migration 0016 only): the single service line name before service_line existed. Kept so
/// no data is destroyed; nothing in the app reads or writes it now. Formerly: ServiceLineService wrote it; every change is appended to service_line_settings_history in the same
/// transaction. Length limits: AppConfig-style constants in ServiceLine (DB check constraints as backstop).
model ServiceLineSettings {
  id        String   @id @default("service_line")
  /// Full name, e.g. "Cardiovascular & Pulmonary Service Line" (top bar and report title).
  name      String   @map("service_line_name")
  /// Short name for narrow screens, e.g. "CVPSL".
  shortName String   @map("service_line_short")
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("service_line_settings")
}

/// Append-only audit trail of service line settings changes (old value, new value, who, when).
/// DB trigger blocks UPDATE/DELETE.
model ServiceLineSettingsHistory {
  id        String   @id @default(uuid()) @db.Uuid
  oldValue  Json
  newValue  Json
  changedAt DateTime @default(now())
  changedBy String

  @@index([changedAt])
  @@map("service_line_settings_history")
}

/// One step of a project's milestone checklist (migration 0015). The derived next milestone is the first
/// step that is not done, by position (MilestoneProgress). Only MilestoneService writes steps; every change
/// writes ProjectHistory rows in the same transaction. Name: up to 2,000 characters for new or renamed steps
/// (MilestoneRules.NAME_MAX); the dashboard and PDF still show at most two lines.
model ProjectMilestone {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  name             String
  dueDate          DateTime? @db.Date
  done             Boolean   @default(false)
  /// America/New_York calendar date the step was checked off. Null while not done (DB check).
  doneAt           DateTime? @db.Date
  /// Email of who checked the step (migration 0022), or a "system ..." actor. Set on check, cleared on uncheck; null for
  /// steps checked before 0022 (never backfilled).
  doneBy           String?
  /// When the step was checked (migration 0022). Set and cleared with doneBy.
  checkedAt        DateTime?
  /// Optional owner (migration 0029): a name from the line's Owners list (ServiceLine.owners), like Project.owner.
  /// Null = Unassigned. A People page rename updates it with the projects (PeopleService.renamePerson).
  owner            String?
  /// 1-based order within the project.
  position         Int
  /// Template the step was copied from (kept for the "From '<template>'" note). Editing or deleting the
  /// template never changes the step.
  sourceTemplateId String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceTemplate MilestoneTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@map("project_milestones")
}

/// Admin-editable milestone template (seeded by migration 0015). Only MilestoneTemplateService writes it;
/// every change is appended to milestone_template_history in the same transaction.
model MilestoneTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  /// Service line the template belongs to (migration 0016).
  serviceLineId String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  name          String
  position      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  updatedBy     String

  items      MilestoneTemplateItem[]
  milestones ProjectMilestone[]

  @@index([serviceLineId, position])
  @@map("milestone_templates")
}

model MilestoneTemplateItem {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  /// Up to 40 characters (MilestoneRules; DB check as backstop).
  name       String
  /// 1-based order within the template.
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  template MilestoneTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("milestone_template_items")
}

/// Append-only audit trail of template changes (old value, new value, who, when). DB trigger blocks
/// UPDATE/DELETE. templateId is not a foreign key so the trail outlives a deleted template.
model MilestoneTemplateHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  templateId    String?     @db.Uuid
  /// e.g. "template_created", "template_renamed", "item_added", "items_reordered", "template_deleted".
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String

  @@index([changedAt])
  @@index([serviceLineId, changedAt])
  @@map("milestone_template_history")
}

/// A service line (migration 0016). The default line (CVPSL, isDefault) holds everything that existed before
/// and can't be archived or deleted (DB check). Only ServiceLineService writes it; every change is appended to
/// service_line_history in the same transaction. Delete is soft (deletedAt) and restorable from /admin/audit.
model ServiceLine {
  id             String        @id @default(uuid()) @db.Uuid
  /// Full name, e.g. "Cardiovascular & Pulmonary Service Line". 1 to 80 characters; unique among lines not deleted.
  name           String
  /// Short name, e.g. "CVPSL". 2 to 12 uppercase letters and digits; unique among lines not deleted.
  shortName      String
  isDefault      Boolean       @default(false)
  /// LEGACY (read by migration 0018 only): the departments a line used before the department table.
  departments    ServiceArea[] @default([])
  /// Contracts lead pick-list (exact spelling; stored canonical on projects).
  contractsLeads String[]      @default([])
  /// Owner pick-list (Admin > People). "To assign" is built in and never stored here.
  owners         String[]      @default([])
  /// Requester pick-list (Admin > People). "Not applicable" and "To assign" are built in and never stored here.
  requesters     String[]      @default([])
  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updatedBy      String

  projects         Project[]
  snapshots        ReportSnapshot[]
  reportOptions    ReportOptions?
  reportOptionsLog ReportOptionsHistory[]
  templates        MilestoneTemplate[]
  templateLog      MilestoneTemplateHistory[]
  history          ServiceLineHistory[]
  activeFor        ServiceLineUserState[]
  layout           LineLayout?
  layoutLog        LineLayoutHistory[]
  departmentRows   Department[]
  departmentLog    DepartmentHistory[]
  yearEndReports   YearEndReport[]
  accessGrants     ServiceLineAccessGrant[]
  accessLog        ServiceLineAccessHistory[]

  @@map("service_line")
}

/// Append-only audit trail of service line changes (created, renamed, archived, deleted, restored, departments,
/// contracts leads). DB trigger blocks UPDATE/DELETE.
model ServiceLineHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceLineId, changedAt])
  @@map("service_line_history")
}

/// The service line each person last switched to (one row per signed-in email). Missing, archived, deleted or no-longer-granted
/// lines fall back to the first line the person may use (ServiceLineAccess).
model ServiceLineUserState {
  email         String      @id
  serviceLineId String      @db.Uuid
  updatedAt     DateTime    @updatedAt
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@map("service_line_user_state")
}

/// Dashboard and PDF layout of one service line, shared by everyone on the line (migration 0017). No row, or a
/// null column, means the default: today's column widths and order, and the report order in every department.
/// Only LineLayoutService writes it; every admin change is appended to line_layout_history in the same transaction.
model LineLayout {
  serviceLineId String      @id @db.Uuid
  /// ColumnLayoutValue: { order, shares } (shares of the table width). Null = default widths and order.
  columnsJson   Json?
  /// RowOrderValue: { <department group>: projectId[] }. A department without a list keeps the report order.
  rowOrderJson  Json?
  updatedAt     DateTime    @updatedAt
  updatedBy     String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@map("line_layout")
}

/// Append-only audit trail of layout changes per line (columns, columns.reset, rows, rows.reset). DB trigger
/// blocks UPDATE/DELETE.
model LineLayoutHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceLineId, changedAt])
  @@map("line_layout_history")
}

/// A department of one service line (migration 0018). Only DepartmentService writes it; every change is appended
/// to department_history in the same transaction. Position is the PDF and dashboard order (Unassigned always
/// comes last and is not a department). Archive hides it from filters, pick-lists and new projects; delete is soft
/// and restorable from /admin/audit. Name (1 to 40) and short name (1 to 12) are unique per line among departments
/// not deleted, ignoring case (DB unique indexes as backstop).
model Department {
  id            String                  @id @default(uuid()) @db.Uuid
  serviceLineId String                  @db.Uuid
  /// Full name, shown in the filter and project pick-lists (e.g. "Cath Lab").
  name          String
  /// Shown in PDF headings and the summary grid (e.g. "Cath").
  shortName     String
  position      Int
  /// The ServiceArea value a seeded department replaced (maps pre-0018 data); null for departments added since.
  legacyKey     ServiceArea?
  archivedAt    DateTime?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  updatedBy     String
  serviceLine   ServiceLine             @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  projects      Project[]
  accessGrants  DepartmentAccessGrant[]

  /// Target of department_access's (departmentId, serviceLineId) key, so a department grant always names a department of its own line (0024).
  @@unique([id, serviceLineId])
  @@index([serviceLineId, position])
  @@map("department")
}

/// Append-only audit trail of department changes (created, renamed, moved, archived, unarchived, deleted, restored).
/// DB trigger blocks UPDATE/DELETE. departmentId is not a foreign key so the trail outlives anything.
model DepartmentHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  departmentId  String?     @db.Uuid
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceLineId, changedAt])
  @@map("department_history")
}

/// On-demand year-end report PDFs (Reports > Year-end report). Never a weekly snapshot: never emailed, never
/// delivered to Drive, never scheduled. Each generation stores its file with the date and the generator.
/// Append-only (a DB trigger blocks UPDATE and DELETE).
model YearEndReport {
  id              String   @id @default(uuid()) @db.Uuid
  serviceLineId   String   @db.Uuid
  /// "FY27"
  fiscalYear      String
  /// Fiscal year start (Jul 1).
  periodStart     DateTime @db.Date
  /// Fiscal year end (Jun 30), or the generation day for a current-year ("to date") report.
  periodEnd       DateTime @db.Date
  toDate          Boolean
  fileName        String
  contentType     String
  bytes           Bytes
  byteSize        Int
  sha256          String
  generatedAt     DateTime @default(now())
  /// Email of the admin who generated it.
  generatedBy     String
  /// Display name at generation ("Nick Leary"); null when the account has no name.
  generatedByName String?

  serviceLine ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceLineId, generatedAt])
  @@map("year_end_report")
}

/// Infor request numbers a project had before this tracker recorded its history (migration 0021). Dated number
/// changes live in ProjectHistory (field "inforRequestNumber"); rows here are the earlier ones. Append-only (trigger).
model ProjectPriorInforNumber {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  /// Whole number 1 to 99999 (shown as InforNumber.format).
  number     Int
  /// When the number was known to change; null = date unknown ("Before this tracker"). Never invented.
  recordedAt DateTime?
  /// Where it came from ("seed_0021").
  source     String
  createdAt  DateTime  @default(now())
  createdBy  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, number])
  @@map("project_prior_infor_number")
}

/// Email and password sign-in (migration 0025): one argon2id hash per person, set or reset only by an admin on
/// Admin > People. Sign-in still requires ALLOWED_EMAILS.
model PasswordCredential {
  email         String    @id
  passwordHash  String
  passwordSetAt DateTime  @default(now())
  passwordSetBy String
  lastSignInAt  DateTime?
  /// True for a temporary password an admin set; the person must choose their own at first sign-in.
  mustChange    Boolean   @default(true)
  user          AppUser   @relation(fields: [email], references: [email], onDelete: Cascade)

  @@map("password_credential")
}

/// Sign-in turned off by an admin ("Off", migration 0025): blocks password and Google (and any provider), even for
/// ALLOWED_EMAILS or ADMIN_EMAILS. Keyed by email, no foreign key, so Google-only people can be turned off too.
model SignInBlock {
  email     String   @id
  blockedAt DateTime @default(now())
  blockedBy String

  @@map("sign_in_block")
}

/// Failed password attempts per typed email (with or without an account): 5 failures lock it for 15 minutes.
model PasswordSignInAttempt {
  email        String    @id
  failedCount  Int       @default(0)
  lastFailedAt DateTime?
  lockedUntil  DateTime?

  @@map("password_sign_in_attempt")
}

/// Append-only log of password changes (set, reset by an admin; changed by the person). DB trigger blocks UPDATE/DELETE.
model PasswordCredentialHistory {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  action    String
  changedAt DateTime @default(now())
  changedBy String

  @@index([email, changedAt])
  @@map("password_credential_history")
}

/// Password sign-in rate limit (fixed window per "ip:<address>" or "email:<email>"), shared by every serverless instance.
model PasswordRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
  @@map("password_rate_limit")
}

/// People who can be given service line access (migration 0023): added by an admin on Admin > People > Access, or
/// recorded on their first page load after sign-in. Sign-in itself is still ALLOWED_EMAILS. Email lowercased.
model AppUser {
  email         String                   @id
  /// Display name from the identity provider at the last sign-in, when it has a real one.
  name          String?
  firstSignInAt DateTime?
  /// Admin who added the email before its first sign-in (null when recorded at first sign-in).
  addedBy       String?
  createdAt     DateTime                 @default(now())
  /// Account menu "Dashboard heartbeat" switch (migration 0028). Off: no heartbeat line or tile washes on the dashboard.
  dashboardHeartbeat Boolean                  @default(true)
  access        ServiceLineAccessGrant[]
  password      PasswordCredential?

  @@map("app_user")
}

/// One row per (person, service line) they may see (item 8). Admins see every line without rows.
model ServiceLineAccessGrant {
  email          String
  serviceLineId  String                  @db.Uuid
  grantedAt      DateTime                @default(now())
  grantedBy      String
  /// All departments of the line, including ones added later (migration 0024). False: only the department_access rows.
  allDepartments Boolean                 @default(true)
  user           AppUser                 @relation(fields: [email], references: [email], onDelete: Cascade)
  serviceLine    ServiceLine             @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  departments    DepartmentAccessGrant[]

  @@id([email, serviceLineId])
  @@index([serviceLineId])
  @@map("service_line_access")
}

/// Append-only log of access changes (user_added, granted, revoked). DB trigger blocks UPDATE/DELETE.
model ServiceLineAccessHistory {
  id            String       @id @default(uuid()) @db.Uuid
  email         String
  serviceLineId String?      @db.Uuid
  action        String
  changedAt     DateTime     @default(now())
  changedBy     String
  serviceLine   ServiceLine? @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([email, changedAt])
  @@map("service_line_access_history")
}

/// One row per (person, department) for a line whose access is limited to some departments (migration 0024).
/// Only read when the line's service_line_access row has allDepartments = false. Removing the line access removes
/// these rows (cascade); the department must belong to the same line (composite key).
model DepartmentAccessGrant {
  email         String
  serviceLineId String                 @db.Uuid
  departmentId  String                 @db.Uuid
  grantedAt     DateTime               @default(now())
  grantedBy     String
  lineAccess    ServiceLineAccessGrant @relation(fields: [email, serviceLineId], references: [email, serviceLineId], onDelete: Cascade)
  department    Department             @relation(fields: [departmentId, serviceLineId], references: [id, serviceLineId], onDelete: Restrict)

  @@id([email, departmentId])
  @@index([email, serviceLineId])
  @@index([departmentId])
  @@map("department_access")
}

/// Append-only log of department access changes (granted, revoked, all_on, all_off, moved). DB trigger blocks
/// UPDATE/DELETE. departmentId is not a foreign key so the trail outlives the department. `detail` holds names
/// at the time (moved: from and to).
model DepartmentAccessHistory {
  id            String   @id @default(uuid()) @db.Uuid
  email         String
  serviceLineId String   @db.Uuid
  departmentId  String?  @db.Uuid
  action        String
  detail        Json?
  changedAt     DateTime @default(now())
  changedBy     String

  @@index([serviceLineId, changedAt])
  @@index([email, changedAt])
  @@map("department_access_history")
}
