// Service Line Portfolio Tracker: Prisma schema
// Connection string is supplied via DATABASE_URL (see prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Report order is the declaration order below.
enum ServiceArea {
  Cath
  EP
  Echo
  CVSS
  INU
  CardioNeuro
  IR
}

enum ProjectStatus {
  NotStarted
  OnTrack
  AtRisk
  OffTrack
  OnHold
  Complete
  Cancelled
}

/// Where a set of view settings applies.
enum ViewContext {
  dashboard
  report
}

enum RecipientLine {
  To
  Cc
}

model Project {
  id                     String        @id @default(uuid()) @db.Uuid
  /// Service line the project belongs to (migration 0016). Every read and write is scoped through
  /// ServiceLineAccess; there is no DB default, so a new row must name its line.
  serviceLineId          String        @db.Uuid
  name                   String
  /// What the project is. Optional. Length limit is AppConfig.DESCRIPTION_MAX_LENGTH (200), enforced in app validation.
  description            String?
  /// Infor request number: optional whole number 1 to 99999 (shown as "REQ-5081"). Range enforced in app
  /// validation (AppConfig.INFOR_REQUEST_NUMBER_MIN/MAX); DB check constraint as backstop.
  inforRequestNumber     Int?          @map("infor_request_number")
  serviceArea            ServiceArea?
  owner                  String?
  physicianChampion      String?
  physicianChampionEmail String?
  /// Requester (physicianChampion) marked Not applicable: renders blank. A name clears it.
  requesterNotApplicable Boolean       @default(false)
  /// Contracts lead, one of the project's service line contractsLeads (null = "To assign").
  contractsLead          String?
  status                 ProjectStatus
  /// Required unless status is Complete/Cancelled (enforced in app validation).
  nextMilestone          String?
  dueDate                DateTime?     @db.Date
  targetCompletion       DateTime?     @db.Date
  /// 0 to 100 (enforced in app validation; DB check constraint as backstop).
  percentComplete        Int?
  /// Length limit is AppConfig.NOTE_MAX_LENGTH (200), enforced on save in app validation.
  note                   String?
  /// What the finished project accomplished (optional; shown in the report's "Completed this period" block).
  /// Length limit is AppConfig.ACCOMPLISHMENT_MAX_LENGTH (200), enforced in app validation.
  accomplishment         String?
  /// Completion date as entered (optional; display only). The "Completed this period" clock is the time the
  /// status became Complete in the app (ProjectHistory), never this date.
  completedOn            DateTime?     @db.Date
  /// Set when the project was listed in a frozen report's "Completed this period" block, so it is listed
  /// only once. Cleared when the status leaves Complete. Bookkeeping only (no history row).
  completionReportedAt   DateTime?
  includeInReport        Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  updatedBy              String
  /// Soft delete only (admin "Delete"); projects are never hard deleted. Deleted projects are invisible to non-admins.
  archivedAt             DateTime?
  /// Who soft-deleted the project (admin email). Set together with archivedAt; cleared on restore.
  deletedBy              String?
  /// Admin per-project hide, per context. Hidden projects are invisible to non-admins in that context
  /// (rows, counts, flags, history). Only ProjectService admin methods write these; every change is audited.
  hiddenFromDashboard    Boolean       @default(false)
  hiddenFromReport       Boolean       @default(false)
  /// DEPRECATED (unused since view settings replaced the "closed projects drop off after one report"
  /// rule). Kept so existing data is not destroyed; nothing reads or writes it.
  closedReportedAt       DateTime?

  history     ProjectHistory[]
  milestones  ProjectMilestone[]
  serviceLine ServiceLine        @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceArea, status])
  @@index([archivedAt])
  @@index([serviceLineId, archivedAt])
}

/// Append-only audit trail. No update/delete paths exist in the app; DB triggers block them too.
model ProjectHistory {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  changedBy String
  comment   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, changedAt])
  @@index([changedAt])
}

/// Immutable report snapshot. Only delivery fields (pdfStorageKey, sentAt, sentToJson) may be filled in later.
model ReportSnapshot {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Service line the report is for (migration 0016). Scheduled freezes are the default line (CVPSL) only.
  /// Immutable (snapshot guard).
  serviceLineId        String    @db.Uuid
  periodStart          DateTime  @db.Date
  periodEnd            DateTime  @db.Date
  generatedAt          DateTime  @default(now())
  generatedBy          String
  /// Frozen copy of the rows visible in the report view at freeze (ReportRow[]).
  rowsJson             Json
  /// Storage reference (URL or blob key) for the rendered PDF. Null until rendered.
  pdfStorageKey        String?
  sentAt               DateTime?
  sentToJson           Json?
  /// MissingChampion[] computed at generation time.
  missingChampionsJson Json
  /// ReportHeader: status counts overall and per area, computed from the visible (listed) rows only.
  /// Null only for snapshots created before migration 0002.
  headerJson           Json?
  /// ADMIN-ONLY. ViewSettingsValue (report context) in effect at freeze, kept for reproducibility.
  /// Never render to non-admins (VisibilityPolicy.snapshotForViewer strips it). Null only before migration 0002.
  viewSettingsJson     Json?
  /// ADMIN-ONLY. Latest delivery outcome (DeliveryRecord: Drive file ids or the signed fallback link).
  /// The only snapshot field that may change more than once (delivery retries); every attempt is
  /// also logged append-only in report_deliveries.
  deliveryJson         Json?
  /// ReportOptionsValue (e.g. key page on/off) in effect at freeze. Immutable. Null before migration 0004.
  optionsJson          Json?
  /// CompletedRow[]: the "Completed this period" blocks at freeze (visible Complete projects not yet reported).
  /// Immutable. Null before migration 0012.
  completedJson        Json?
  /// ServiceLineValue (service line name and short name) in effect at freeze, used for the report title.
  /// Immutable. Null before migration 0014 (those reports render with the legacy title).
  serviceLineJson      Json?

  artifacts   ReportArtifact[]
  deliveries  ReportDelivery[]
  serviceLine ServiceLine      @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  /// One snapshot per report period: the freeze job is idempotent on this key.
  @@unique([periodStart, periodEnd])
  @@index([generatedAt])
}

/// Immutable rendered files of a snapshot (PDF, handoff.json). ReportSnapshot.pdfStorageKey points here
/// as "db:report_artifacts/<id>". DB triggers block UPDATE/DELETE.
model ReportArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @db.Uuid
  /// "pdf" | "handoff"
  kind        String
  fileName    String
  contentType String
  bytes       Bytes
  byteSize    Int
  sha256      String
  createdAt   DateTime @default(now())

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, kind])
  @@map("report_artifacts")
}

/// Append-only log of delivery attempts (Drive upload or signed-link fallback). DB trigger blocks UPDATE/DELETE.
model ReportDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @db.Uuid
  attemptedAt DateTime @default(now())
  /// "drive" | "signed_link"
  method      String
  /// "ok" | "failed" | "skipped"
  status      String
  /// Method details: Drive file ids and links, or the signed link and its expiry, or the error.
  detailJson  Json
  triggeredBy String

  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([snapshotId, attemptedAt])
  @@map("report_deliveries")
}

/// Kept in the schema, but nothing drives sending from it: the report email goes to Nick's work email only.
model Recipient {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  email       String        @unique
  role        String?
  /// Null = all service areas.
  serviceArea ServiceArea?
  line        RecipientLine
  /// Deactivate, never delete.
  active      Boolean       @default(true)
}

/// Global (not per-user) show/hide settings, one row per context. Only written by ViewSettingsService.
model ViewSettings {
  context        ViewContext     @id
  /// Full column order for the context (ViewColumn keys, see ViewSettings). Validated in the app.
  columnOrder    String[]
  /// Hidden ViewColumn keys. Locked columns (project, status) are never stored here.
  hiddenColumns  String[]
  hiddenStatuses ProjectStatus[]
  updatedAt      DateTime        @updatedAt
  updatedBy      String

  @@map("view_settings")
}

/// Append-only audit trail of view settings changes. DB trigger blocks UPDATE/DELETE.
model ViewSettingsHistory {
  id        String      @id @default(uuid()) @db.Uuid
  context   ViewContext
  /// ViewSettingsValue before the change.
  oldValue  Json
  /// ViewSettingsValue after the change.
  newValue  Json
  changedAt DateTime    @default(now())
  changedBy String

  @@index([context, changedAt])
  @@map("view_settings_history")
}

/// Admin report options, one row per service line (the default line keeps id "report"). Only
/// ReportOptionsService writes it; every change is appended to report_options_history in the same transaction.
model ReportOptions {
  id            String      @id @default("report")
  serviceLineId String      @unique @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  /// Last page with the status and flag key. Default on.
  showKeyPage   Boolean     @default(true)
  updatedAt     DateTime    @updatedAt
  updatedBy     String

  @@map("report_options")
}

/// Append-only audit trail of report options changes. DB trigger blocks UPDATE/DELETE.
model ReportOptionsHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  oldValue      Json
  newValue      Json
  changedAt     DateTime    @default(now())
  changedBy     String

  @@index([changedAt])
  @@index([serviceLineId, changedAt])
  @@map("report_options_history")
}

/// LEGACY (read by migration 0016 only): the single service line name before service_line existed. Kept so
/// no data is destroyed; nothing in the app reads or writes it now. Formerly: ServiceLineService wrote it; every change is appended to service_line_settings_history in the same
/// transaction. Length limits: AppConfig-style constants in ServiceLine (DB check constraints as backstop).
model ServiceLineSettings {
  id        String   @id @default("service_line")
  /// Full name, e.g. "Cardiovascular & Pulmonary Service Line" (top bar and report title).
  name      String   @map("service_line_name")
  /// Short name for narrow screens, e.g. "CVPSL".
  shortName String   @map("service_line_short")
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("service_line_settings")
}

/// Append-only audit trail of service line settings changes (old value, new value, who, when).
/// DB trigger blocks UPDATE/DELETE.
model ServiceLineSettingsHistory {
  id        String   @id @default(uuid()) @db.Uuid
  oldValue  Json
  newValue  Json
  changedAt DateTime @default(now())
  changedBy String

  @@index([changedAt])
  @@map("service_line_settings_history")
}

/// One step of a project's milestone checklist (migration 0015). The derived next milestone is the first
/// step that is not done, by position (MilestoneProgress). Only MilestoneService writes steps; every change
/// writes ProjectHistory rows in the same transaction. Name: 40 characters for new or renamed steps
/// (MilestoneRules); text migrated from Project.nextMilestone may be longer until it is edited.
model ProjectMilestone {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  name             String
  dueDate          DateTime? @db.Date
  done             Boolean   @default(false)
  /// America/New_York calendar date the step was checked off. Null while not done (DB check).
  doneAt           DateTime? @db.Date
  /// 1-based order within the project.
  position         Int
  /// Template the step was copied from (kept for the "From '<template>'" note). Editing or deleting the
  /// template never changes the step.
  sourceTemplateId String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sourceTemplate MilestoneTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@map("project_milestones")
}

/// Admin-editable milestone template (seeded by migration 0015). Only MilestoneTemplateService writes it;
/// every change is appended to milestone_template_history in the same transaction.
model MilestoneTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  /// Service line the template belongs to (migration 0016).
  serviceLineId String      @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  name          String
  position      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  updatedBy     String

  items      MilestoneTemplateItem[]
  milestones ProjectMilestone[]

  @@index([serviceLineId, position])
  @@map("milestone_templates")
}

model MilestoneTemplateItem {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  /// Up to 40 characters (MilestoneRules; DB check as backstop).
  name       String
  /// 1-based order within the template.
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  template MilestoneTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("milestone_template_items")
}

/// Append-only audit trail of template changes (old value, new value, who, when). DB trigger blocks
/// UPDATE/DELETE. templateId is not a foreign key so the trail outlives a deleted template.
model MilestoneTemplateHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)
  templateId    String?     @db.Uuid
  /// e.g. "template_created", "template_renamed", "item_added", "items_reordered", "template_deleted".
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String

  @@index([changedAt])
  @@index([serviceLineId, changedAt])
  @@map("milestone_template_history")
}

/// A service line (migration 0016). The default line (CVPSL, isDefault) holds everything that existed before
/// and can't be archived or deleted (DB check). Only ServiceLineService writes it; every change is appended to
/// service_line_history in the same transaction. Delete is soft (deletedAt) and restorable from /admin/audit.
model ServiceLine {
  id             String        @id @default(uuid()) @db.Uuid
  /// Full name, e.g. "Cardiovascular & Pulmonary Service Line". 1 to 80 characters; unique among lines not deleted.
  name           String
  /// Short name, e.g. "CVPSL". 2 to 12 uppercase letters and digits; unique among lines not deleted.
  shortName      String
  isDefault      Boolean       @default(false)
  /// Departments this line uses, in report order (the default line has all of them).
  departments    ServiceArea[] @default([])
  /// Contracts lead pick-list (exact spelling; stored canonical on projects).
  contractsLeads String[]      @default([])
  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updatedBy      String

  projects         Project[]
  snapshots        ReportSnapshot[]
  reportOptions    ReportOptions?
  reportOptionsLog ReportOptionsHistory[]
  templates        MilestoneTemplate[]
  templateLog      MilestoneTemplateHistory[]
  history          ServiceLineHistory[]
  activeFor        ServiceLineUserState[]

  @@map("service_line")
}

/// Append-only audit trail of service line changes (created, renamed, archived, deleted, restored, departments,
/// contracts leads). DB trigger blocks UPDATE/DELETE.
model ServiceLineHistory {
  id            String      @id @default(uuid()) @db.Uuid
  serviceLineId String      @db.Uuid
  action        String
  oldValue      Json?
  newValue      Json?
  changedAt     DateTime    @default(now())
  changedBy     String
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@index([serviceLineId, changedAt])
  @@map("service_line_history")
}

/// The service line each admin last switched to (one row per signed-in email). Missing, archived or deleted
/// lines fall back to the default line (ServiceLineAccess).
model ServiceLineUserState {
  email         String      @id
  serviceLineId String      @db.Uuid
  updatedAt     DateTime    @updatedAt
  serviceLine   ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Restrict)

  @@map("service_line_user_state")
}
